# Ollama (local, free)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
LLM_MODEL=llama3

# Chunking settings (tune these and re-run scripts/ingest.py)
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval threshold (lower score = closer match; if best score is above
# this, the LLM is not called and the system returns "I don't know").
SIMILARITY_THRESHOLD=0.3

# Rate limiting (requests per client IP per window)
RATE_LIMIT=10
RATE_LIMIT_WINDOW=60

# Token cost estimation (USD per 1,000 tokens)
# Set to 0.0 if you are using a local model like Ollama.
INPUT_COST_PER_1K=0.0005
OUTPUT_COST_PER_1K=0.0015

# Groq example
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_...
# LLM_MODEL=llama3-8b-8192
